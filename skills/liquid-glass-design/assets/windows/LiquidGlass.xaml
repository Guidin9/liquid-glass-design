<!-- Liquid Glass resources for WinUI 3. Merge into App.xaml:
       <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="LiquidGlass.xaml"/></ResourceDictionary.MergedDictionaries>
     Glass = in-app AcrylicBrush (blurs the app content behind it) + specular rim + ThemeShadow. WinUI has no
     displacement effect for backdrops, so there is no lensing; the rim and shadow carry the material.
     Starting point: not compiled in this repo; check against your Windows App SDK version. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="LgGroupedBackgroundBrush" Color="#FFF2F2F7"/>
            <SolidColorBrush x:Key="LgCellBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="LgLabelBrush" Color="#FF000000"/>
            <SolidColorBrush x:Key="LgSecondaryLabelBrush" Color="#993C3C43"/>
            <SolidColorBrush x:Key="LgTertiaryLabelBrush" Color="#4D3C3C43"/>
            <SolidColorBrush x:Key="LgSeparatorBrush" Color="#4A3C3C43"/>
            <SolidColorBrush x:Key="LgFillBrush" Color="#1F767680"/>
            <SolidColorBrush x:Key="LgTintBrush" Color="#FF007AFF"/>
            <SolidColorBrush x:Key="LgRedBrush" Color="#FFFF3B30"/>
            <SolidColorBrush x:Key="LgGlassSelectionBrush" Color="#1A000000"/>
            <AcrylicBrush x:Key="LgGlassBrush"
                          TintColor="#FFFAFAFA"
                          TintOpacity="0.30"
                          TintLuminosityOpacity="0.55"
                          FallbackColor="#F0FAFAFA"/>
            <LinearGradientBrush x:Key="LgGlassRimBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#B3FFFFFF" Offset="0"/>
                <GradientStop Color="#1FFFFFFF" Offset="0.35"/>
                <GradientStop Color="#1FFFFFFF" Offset="0.65"/>
                <GradientStop Color="#66FFFFFF" Offset="1"/>
            </LinearGradientBrush>
            <!-- Bottom scroll edge effect: content dissolves into the background behind the floating bar. -->
            <LinearGradientBrush x:Key="LgBottomEdgeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00F2F2F7" Offset="0"/>
                <GradientStop Color="#B3F2F2F7" Offset="0.45"/>
                <GradientStop Color="#F5F2F2F7" Offset="1"/>
            </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="LgGroupedBackgroundBrush" Color="#FF000000"/>
            <SolidColorBrush x:Key="LgCellBrush" Color="#FF1C1C1E"/>
            <SolidColorBrush x:Key="LgLabelBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="LgSecondaryLabelBrush" Color="#99EBEBF5"/>
            <SolidColorBrush x:Key="LgTertiaryLabelBrush" Color="#4DEBEBF5"/>
            <SolidColorBrush x:Key="LgSeparatorBrush" Color="#99545458"/>
            <SolidColorBrush x:Key="LgFillBrush" Color="#3D767680"/>
            <SolidColorBrush x:Key="LgTintBrush" Color="#FF0A84FF"/>
            <SolidColorBrush x:Key="LgRedBrush" Color="#FFFF453A"/>
            <SolidColorBrush x:Key="LgGlassSelectionBrush" Color="#1AFFFFFF"/>
            <AcrylicBrush x:Key="LgGlassBrush"
                          TintColor="#FF121212"
                          TintOpacity="0.35"
                          TintLuminosityOpacity="0.6"
                          FallbackColor="#F01C1C1E"/>
            <LinearGradientBrush x:Key="LgGlassRimBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#59FFFFFF" Offset="0"/>
                <GradientStop Color="#0FFFFFFF" Offset="0.35"/>
                <GradientStop Color="#0FFFFFFF" Offset="0.65"/>
                <GradientStop Color="#33FFFFFF" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LgBottomEdgeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00000000" Offset="0"/>
                <GradientStop Color="#B3000000" Offset="0.45"/>
                <GradientStop Color="#F5000000" Offset="1"/>
            </LinearGradientBrush>
        </ResourceDictionary>

        <!-- High contrast: solid surfaces and system colors, no translucency. -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="LgGroupedBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="LgCellBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="LgLabelBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="LgSecondaryLabelBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="LgTertiaryLabelBrush" Color="{ThemeResource SystemColorGrayTextColor}"/>
            <SolidColorBrush x:Key="LgSeparatorBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="LgFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="LgTintBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="LgRedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="LgGlassSelectionBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="LgGlassBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="LgGlassRimBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="LgBottomEdgeBrush" Color="Transparent"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Inter (OFL) packaged at Assets/Fonts/Inter.ttf; SF Pro may not be shipped on Windows. -->
    <FontFamily x:Key="LgFont">ms-appx:///Assets/Fonts/Inter.ttf#Inter</FontFamily>

    <!-- iOS text styles. CharacterSpacing is in 1/1000 em. -->
    <Style x:Key="LgLargeTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LgFont}"/>
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LineHeight" Value="41"/>
        <Setter Property="CharacterSpacing" Value="-18"/>
        <Setter Property="Foreground" Value="{ThemeResource LgLabelBrush}"/>
    </Style>
    <Style x:Key="LgHeadlineStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LgFont}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="22"/>
        <Setter Property="CharacterSpacing" Value="-18"/>
        <Setter Property="Foreground" Value="{ThemeResource LgLabelBrush}"/>
    </Style>
    <Style x:Key="LgBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LgFont}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="LineHeight" Value="22"/>
        <Setter Property="CharacterSpacing" Value="-18"/>
        <Setter Property="Foreground" Value="{ThemeResource LgLabelBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="LgValueStyle" TargetType="TextBlock" BasedOn="{StaticResource LgBodyStyle}">
        <Setter Property="Foreground" Value="{ThemeResource LgSecondaryLabelBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style x:Key="LgFootnoteStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LgFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{ThemeResource LgSecondaryLabelBrush}"/>
    </Style>

    <!-- Content layer: opaque inset group (WinUI corners are circular; keep them large). -->
    <Style x:Key="LgInsetGroupStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LgCellBrush}"/>
        <Setter Property="CornerRadius" Value="26"/>
    </Style>
    <Style x:Key="LgRowStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="52"/>
        <Setter Property="Padding" Value="16,10"/>
    </Style>
    <Style x:Key="LgSeparatorStyle" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="16,0,0,0"/>
        <Setter Property="Background" Value="{ThemeResource LgSeparatorBrush}"/>
    </Style>

    <!-- Navigation layer: floating glass capsule (64 tall, radius 32, 4 inset). Add Translation="0,0,32" and a
         ThemeShadow on the element itself; those can't be set from a Style. -->
    <Style x:Key="LgGlassBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LgGlassBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource LgGlassRimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="32"/>
        <Setter Property="Height" Value="64"/>
        <Setter Property="Padding" Value="4"/>
    </Style>
    <Style x:Key="LgTabButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="28"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{ThemeResource LgLabelBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource LgFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
</ResourceDictionary>
