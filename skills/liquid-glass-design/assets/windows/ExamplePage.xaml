<!-- WinUI 3 example: opaque grouped content scrolling under a floating glass tab bar.
     Code-behind (C#) for the selection lens:
       Lens.TranslationTransition = new Vector3Transition { Duration = TimeSpan.FromMilliseconds(350) };
       void Select(int i) { Lens.Translation = new Vector3((float)(i * Lens.ActualWidth), 0, 0); SummaryTab.Foreground =
         i == 0 ? tint : label; SettingsTab.Foreground = i == 1 ? tint : label; }
     Starting point: not compiled in this repo. -->
<Page
    x:Class="App.ExamplePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource LgGroupedBackgroundBrush}">
        <!-- Content layer -->
        <ScrollViewer>
            <StackPanel MaxWidth="720" Padding="16,44,16,104">
                <TextBlock Text="Settings" Style="{StaticResource LgLargeTitleStyle}" Margin="4,0,0,4"/>

                <TextBlock Text="General" Style="{StaticResource LgHeadlineStyle}" Margin="16,28,16,8"/>
                <Border Style="{StaticResource LgInsetGroupStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource LgRowStyle}">
                            <TextBlock Text="Version" Style="{StaticResource LgBodyStyle}"/>
                            <TextBlock Text="2.1" Style="{StaticResource LgValueStyle}"/>
                        </Grid>
                        <Border Style="{StaticResource LgSeparatorStyle}"/>
                        <Grid Style="{StaticResource LgRowStyle}">
                            <TextBlock Text="Sync" Style="{StaticResource LgBodyStyle}"/>
                            <!-- Retemplate ToggleSwitch for the iOS 64x28 track / 40x24 knob, or keep the system one. -->
                            <ToggleSwitch HorizontalAlignment="Right" IsOn="True" OnContent="" OffContent="" MinWidth="0"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock Text="Explanations go in footers." Style="{StaticResource LgFootnoteStyle}" Margin="16,8,16,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom scroll edge effect behind the bar -->
        <Rectangle Height="96" VerticalAlignment="Bottom" IsHitTestVisible="False" Fill="{ThemeResource LgBottomEdgeBrush}"/>

        <!-- Navigation layer: the only glass -->
        <Border Style="{StaticResource LgGlassBarStyle}" Width="216" Margin="0,0,0,12"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Translation="0,0,32">
            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Lens" Grid.Column="0" CornerRadius="28" Background="{ThemeResource LgGlassSelectionBrush}"/>
                <Button x:Name="SummaryTab" Grid.Column="0" Style="{StaticResource LgTabButtonStyle}"
                        Foreground="{ThemeResource LgTintBrush}" AutomationProperties.Name="Summary">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE80F;" FontSize="20"/>
                        <TextBlock Text="Summary" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SettingsTab" Grid.Column="1" Style="{StaticResource LgTabButtonStyle}"
                        AutomationProperties.Name="Settings">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE713;" FontSize="20"/>
                        <TextBlock Text="Settings" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
